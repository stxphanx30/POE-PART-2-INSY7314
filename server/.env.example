# Server
PORT=5000
NODE_ENV=development
FORCE_SECURE=false   # mettre true si tu souhaites forcer secure cookies (ex: HTTPS en prod)

# Database
MONGO_URI=mongodb://localhost:27017/payments-portal

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=24h

# SSL paths (relatifs au dossier server/)
SSL_KEY_PATH=./config/ssl/localhost-key.pem
SSL_CERT_PATH=./config/ssl/localhost.pem

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session management
SESSION_SECRET=your-super-strong-secret-key
SESSION_NAME=sessionId
SESSION_MAX_AGE_MS=1800000
SESSION_SAMESITE=lax
SESSION_COLLECTION=sessions
